{
  "expo": {
    "name": "LifeTrack Pro",
    "slug": "lifetrack-pro",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "lifetrackpro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lifetrackpro.app",
      "buildNumber": "6",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ],
        "NSMicrophoneUsageDescription": "LifeTrack Pro does not use the microphone.",
        "NSMotionUsageDescription": "Used for haptic feedback during focus sessions.",
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "ITSAppUsesNonExemptEncryption": false,
        "GADApplicationIdentifier": "ca-app-pub-3940256099942544~1458002511"
      }
    },
    "android": {
      "package": "com.lifetrackpro.app",
      "versionCode": 6,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5B5CF0"
        }
      ],
      "@sentry/react-native/expo",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "android_app_id": "ca-app-pub-3940256099942544~3347511713",
          "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-localization",
      "posthog-react-native/expo",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9f5a5fa-ec1b-4533-90bd-066c6913f67e"
      }
    },
    "owner": "abhishek74",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/f9f5a5fa-ec1b-4533-90bd-066c6913f67e"
    }
  }
}
