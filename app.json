{
  "expo": {
    "name": "LifeTrack Pro",
    "slug": "lifetrack-pro",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lifetrackpro",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lifetrackpro.app",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ],
        "NSMicrophoneUsageDescription": "LifeTrack Pro does not use the microphone.",
        "NSMotionUsageDescription": "Used for haptic feedback during focus sessions."
      }
    },
    "android": {
      "package": "com.lifetrackpro.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "organization": "your-org-slug",
          "project": "lifetrack-pro"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f9f5a5fa-ec1b-4533-90bd-066c6913f67e"
      }
    },
    "owner": "abhishek74"
  }
}
