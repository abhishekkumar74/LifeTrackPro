.kotlin/
*.orig.*
*.jks
*.key

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# IDE and local scripts
.vscode/settings.json
scratch/
test-types.ts
coverage/

